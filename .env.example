# Copier ce fichier en .env (à la racine de trackit/ ou dans backend/) puis renseigner les valeurs.
# Ne jamais versionner le fichier .env.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trackit
DB_USERNAME=trackit
DB_PASSWORD=change-me

# --- JWT (au moins 32 caractères ; générer avec : openssl rand -base64 48) ---
JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-48-caracteres-minimum
JWT_EXPIRATION_MINUTES=480

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Stripe (clés de TEST uniquement : sk_test_..., whsec_...) ---
# Laisser vide pour utiliser le mode simulation (aucun appel à Stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optionnel ---
# SERVER_PORT=8080
# UPLOADS_DIR=./uploads
# REPORTS_DIR=./reports
# Désactiver les données de démonstration : FLYWAY_LOCATIONS=classpath:db/migration
